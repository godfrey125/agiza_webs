# Frontend environment variables
#
# These values are compiled into the public frontend bundle. Never put secrets,
# service-role keys, passwords or private API tokens in this file.
#
# Existing Django REST API used for phone OTP authentication and catalogue data.
VITE_API_BASE_URL=http://localhost:8000/api

# Trusted partner verification API. Leave blank until the backend endpoints in
# docs/PARTNER_API.md are deployed. Registration submission and application
# tracking stay disabled while this is blank.
VITE_PARTNER_API_BASE_URL=

# Trusted contact form endpoint. Leave blank until a verified endpoint exists.
# The website intentionally publishes no unverified phone number, email address
# or social account.
VITE_CONTACT_ENDPOINT=

# Public canonical site URL used for metadata and links. Set this only after the
# production domain has been verified; no domain is assumed by default.
VITE_SITE_URL=

# App availability and release information.
# Leave every value below blank until Agiza has a genuine, published release.
# Each store link activates only when set; otherwise the website shows a
# "Coming soon" state and never invents a listing or download URL.
VITE_APP_VERSION=
VITE_APP_SIZE=
VITE_APP_RELEASE_DATE=
VITE_APP_MIN_ANDROID=
VITE_APP_MIN_IOS=
VITE_APP_CHANGELOG_URL=
VITE_APP_PLAY_STORE_URL=
VITE_APP_APP_STORE_URL=
